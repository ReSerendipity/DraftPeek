#!/bin/sh
# 通用 pre-push（无机器特定路径，可随仓库分发）。
#   1) 先执行 gitleaks 待推送提交扫描（密钥防线，最高优先）
#   2) 仓库提供 scripts/precheck.ps1 -> 执行它（家族既有门禁口径）
#   3) 否则 -> 退回根目录守卫 structure-guard
# gitleaks v8.30.1 无 `git pre-push` 子命令，改用 detect --log-opts 扫描 remote..local 范围。
# 紧急绕过：git push --no-verify（仅限用户明确要求时）
failed=0

# 1) gitleaks 扫描待推送提交（密钥防线）
#    退出码用 --exit-code 2 分成三类，互不混淆：
#      0 = 扫描完成且未检出；2 = 检出泄露；其余（含 1）= 工具或配置故障。
#    故障既不放行也不谎报成「检出」，一律 fail-closed，并把真实类别写在提示里。
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "[pre-push] gitleaks 未安装，跳过推送前密钥扫描" >&2
elif [ ! -r gitleaks.toml ]; then
    echo "[pre-push] gitleaks.toml 缺失或不可读，无法执行推送前密钥扫描（属故障，不是泄露）" >&2
    exit 1
else
    while read lref lsha rref rsha; do
        [ -z "$lsha" ] && continue
        if [ "$lsha" = "0000000000000000000000000000000000000000" ]; then
            continue  # 删除远程分支，无需扫描
        fi
        if [ "$rsha" = "0000000000000000000000000000000000000000" ]; then
            range="$lsha"  # 新分支：扫描该分支可达历史
        else
            range="$rsha..$lsha"
        fi
        echo "[pre-push] gitleaks 扫描: $lref ($range)"
        # --source/--config 一律用相对路径：钩子在 Git-Bash/MSYS 下 $(pwd) 给出 /c/... 形式，
        # Windows 原生 gitleaks 打不开该配置并以 FTL 退出，历史上被下面的旧判断读成「检出泄露」。
        gitleaks detect --source . --redact --log-opts="$range" --config gitleaks.toml --exit-code 2
        rc=$?
        case "$rc" in
            0) echo "[pre-push] gitleaks 扫描完成：未检出泄露" ;;
            2) echo "[pre-push] gitleaks 检出泄露，推送已拒绝。绕过：git push --no-verify" >&2
               failed=1 ;;
            *) echo "[pre-push] gitleaks 未能完成扫描（退出码 $rc）：工具或配置故障，" >&2
               echo "          既不是「无泄露」也不是「检出泄露」；按 fail-closed 拒绝推送。" >&2
               echo "          绕过：git push --no-verify" >&2
               failed=1 ;;
        esac
    done
fi

# 2) scripts/precheck.ps1（家族既有门禁）
if [ -f ./scripts/precheck.ps1 ]; then
    echo "[pre-push] 运行本地预检 scripts/precheck.ps1 ..."
    if command -v powershell.exe >/dev/null 2>&1; then
        if ! powershell.exe -NoProfile -ExecutionPolicy Bypass -File "./scripts/precheck.ps1"; then
            echo "[pre-push] 预检未通过。绕过：git push --no-verify" >&2
            exit 1
        fi
    else
        echo "[pre-push] 未找到 powershell.exe，无法执行 scripts/precheck.ps1" >&2
        echo "          绕过：git push --no-verify" >&2
        exit 1
    fi
else
    # 3) structure-guard 根目录守卫
    PY=""
    for cand in ".venv/Scripts/python.exe" ".venv/bin/python"; do
        [ -x "$cand" ] && PY="$cand" && break
    done
    if [ -z "$PY" ]; then
        for c in python python3; do
            command -v "$c" >/dev/null 2>&1 && PY="$c" && break
        done
    fi
    if [ -z "$PY" ]; then
        echo "[pre-push] 无 scripts/precheck.ps1 且未找到 python，跳过推送前检查" >&2
    else
        $PY .github/scripts/check_layout.py || exit 1
    fi
fi
exit $failed
