# .env.example — 环境变量模板
# 复制为 .env 后修改实际值。.env 已被 .gitignore 排除。
# Android 项目一般通过 BuildConfig 或 local.properties 管理配置，
# 此文件用于存放未来可能需要的 API Key、远程服务地址等。

# ============================================================
# API Keys（如有远程服务需要）
# ============================================================
# GITHUB_API_TOKEN=your_github_personal_access_token
# PLAY_INTEGRITY_API_KEY=your_play_integrity_api_key

# ============================================================
# 远程服务地址（如有自建 LSP/同步服务）
# ============================================================
# LSP_SERVER_URL=https://your-lsp-server.example.com
# SYNC_SERVER_URL=https://your-sync-server.example.com

# ============================================================
# 构建配置（一般通过 gradle.properties 管理）
# ============================================================
# DRAFTPEEK_AI_PROTECTION_ENABLED=true
