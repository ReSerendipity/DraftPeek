<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- AI Protection: notification permission for Android 13+ security status notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- PLAN-C FUTURE：新增 <receiver name=".security.PolicyUpdateReceiver" .../> 策略热更新接收器声明 -->

    <!-- Android 11+ 包可见性声明：必须声明才能检测/跳转到第三方应用 -->
    <queries>
        <!-- 任何能打开 http/https 链接的应用（浏览器 / App Links 处理器） -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <!-- 「我的」页面社交链接显式可见的第三方 App -->
        <package android:name="tv.danmaku.bili" />          <!-- B站 -->
        <package android:name="com.ss.android.ugc.aweme" />  <!-- 抖音 -->
        <package android:name="com.xingin.xhs" />            <!-- 小红书 -->
        <package android:name="com.smile.gifmaker" />        <!-- 快手 -->
    </queries>

    <!-- macrobenchmark：release 构建非 debuggable，需声明允许 shell profiling，
         否则 :benchmark 的 macrobenchmark 用例报
         "Target app ... is not debuggable nor profileable"（issue #87）。
         API < 29 的平台会忽略此元素，无运行时影响。 -->
    <profileable
        android:shell="true" />

    <application
        android:name=".DraftPeekApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.DraftPeek"
        android:usesCleartextTraffic="false">

        <!-- Splash: first activity shown on launch.
             configChanges lets the activity survive foldable hinge
             transitions, rotation, font scale and locale changes without
             restarting the splash animation mid-flight. -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.DraftPeek.Splash"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|fontScale|locale|layoutDirection|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Onboarding: shown only on first launch -->
        <activity
            android:name=".onboarding.OnboardingActivity"
            android:exported="false" />

        <!-- Main: the app's primary activity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|layoutDirection|locale"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
