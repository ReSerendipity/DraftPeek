{
  "name": "SQL",
  "scopeName": "source.sql",
  "patterns": [
    { "name": "comment.line.double-dash.sql", "match": "--.*$" },
    { "name": "comment.block.sql", "begin": "/\\*", "end": "\\*/" },
    { "name": "constant.numeric.sql", "match": "\\b[0-9]+(\\.[0-9]+)?\\b" },
    { "name": "string.quoted.single.sql", "match": "'([^'\\\\]|\\\\.)*'" },
    { "name": "keyword.control.sql", "match": "\\b(SELECT|FROM|WHERE|INSERT|INTO|VALUES|UPDATE|SET|DELETE|CREATE|TABLE|ALTER|DROP|INDEX|VIEW|TRIGGER|FUNCTION|PROCEDURE|DATABASE|SCHEMA|GRANT|REVOKE|COMMIT|ROLLBACK|BEGIN|END|IF|ELSE|THEN|WHILE|LOOP|FOR|RETURN|DECLARE|CURSOR|OPEN|FETCH|CLOSE|EXISTS|IN|NOT|AND|OR|IS|NULL|BETWEEN|LIKE|JOIN|LEFT|RIGHT|INNER|OUTER|ON|GROUP|BY|ORDER|ASC|DESC|HAVING|UNION|ALL|DISTINCT|AS|LIMIT|OFFSET|CASE|WHEN|THEN|ELSE|END|PRIMARY|KEY|FOREIGN|REFERENCES|UNIQUE|CHECK|DEFAULT|AUTO_INCREMENT|VARCHAR|INT|INTEGER|BIGINT|SMALLINT|TINYINT|FLOAT|DOUBLE|DECIMAL|DATE|TIME|DATETIME|TIMESTAMP|BOOLEAN|TEXT|BLOB|ENUM|SET)\\b" },
    { "name": "support.function.sql", "match": "\\b(COUNT|SUM|AVG|MIN|MAX|ABS|ROUND|CEIL|FLOOR|LENGTH|UPPER|LOWER|TRIM|SUBSTRING|CONCAT|COALESCE|CAST|NOW|CURRENT_DATE|CURRENT_TIMESTAMP|IFNULL|NULLIF|ROW_NUMBER|RANK|DENSE_RANK|LEAD|LAG|FIRST_VALUE|LAST_VALUE)\\b" },
    { "name": "constant.language.sql", "match": "\\b(TRUE|FALSE|NULL)\\b" },
    { "name": "entity.name.tag.sql", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\s*(?=\\()" },
    { "name": "keyword.operator.sql", "match": "(=|<>|!=|<|>|<=|>=|\\+|-|\\*|/|%)" }
  ]
}
