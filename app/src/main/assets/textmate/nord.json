{
  "name": "Nord",
  "type": "dark",
  "colors": {
    "editor.background": "#2E3440",
    "editor.foreground": "#D8DEE9",
    "editorLineNumber.foreground": "#4C566A",
    "editorLineNumber.activeForeground": "#D8DEE9",
    "editorCursor.foreground": "#88C0D0",
    "editor.selectionBackground": "#434C5E",
    "editor.inactiveSelectionBackground": "#3B4252",
    "editor.lineHighlightBackground": "#3B4252",
    "editorIndentGuide.background": "#3B4252",
    "editorIndentGuide.activeBackground": "#4C566A",
    "editorWhitespace.foreground": "#3B4252",
    "editorBracketMatch.background": "#88C0D030",
    "editorBracketMatch.border": "#88C0D060"
  },
  "tokenColors": [
    { "settings": { "foreground": "#D8DEE9" } },
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#616E88", "fontStyle": "italic" } },
    { "name": "Keywords", "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#81A1C1" } },
    { "name": "Strings", "scope": ["string", "string.quoted"], "settings": { "foreground": "#A3BE8C" } },
    { "name": "Numbers", "scope": ["constant.numeric"], "settings": { "foreground": "#B48EAD" } },
    { "name": "Boolean/Null", "scope": ["constant.language"], "settings": { "foreground": "#81A1C1" } },
    { "name": "Functions", "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#88C0D0" } },
    { "name": "Types/Classes", "scope": ["entity.name.type", "entity.name.class", "support.type"], "settings": { "foreground": "#EBCB8B" } },
    { "name": "Variables", "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#D8DEE9" } },
    { "name": "Operators", "scope": ["keyword.operator"], "settings": { "foreground": "#81A1C1" } },
    { "name": "Punctuation", "scope": ["punctuation"], "settings": { "foreground": "#81A1C1" } },
    { "name": "Annotations", "scope": ["storage.type.annotation", "meta.decorator"], "settings": { "foreground": "#8FBCBB" } },
    { "name": "Tags (HTML/XML)", "scope": ["entity.name.tag"], "settings": { "foreground": "#81A1C1" } },
    { "name": "Tag Attributes", "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#8FBCBB" } },
    { "name": "Regex", "scope": ["string.regexp"], "settings": { "foreground": "#EBCB8B" } },
    { "name": "Escape Characters", "scope": ["constant.character.escape"], "settings": { "foreground": "#B48EAD" } }
  ]
}
