{
  "information_for_contributors": [
    "This is a TextMate grammar for Scala, designed for use with DraftPeek."
  ],
  "name": "Scala",
  "scopeName": "source.scala",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#type-keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#symbols"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#type-declarations"
    },
    {
      "include": "#method-declarations"
    },
    {
      "include": "#packages"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.scala",
          "match": "//.*$"
        },
        {
          "name": "comment.block.scala",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.scala",
          "begin": "([a-zA-Z_][a-zA-Z0-9_]*)?\"\"\"",
          "beginCaptures": {
            "1": {
              "name": "keyword.interpolation.scala"
            }
          },
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.interpolation.scala",
              "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
            },
            {
              "name": "constant.character.escape.interpolation.scala",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "source.scala"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.other.interpolated.scala",
          "begin": "(s|f|raw|t|q)\"",
          "beginCaptures": {
            "1": {
              "name": "keyword.interpolation.scala"
            }
          },
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.interpolation.scala",
              "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
            },
            {
              "name": "constant.character.escape.interpolation.scala",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "source.scala"
                }
              ]
            },
            {
              "name": "constant.character.escape.scala",
              "match": "\\\\(u[0-9a-fA-F]{4}|[btnfr\"'\\\\])"
            }
          ]
        },
        {
          "name": "string.quoted.triple.scala",
          "begin": "\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.single.scala",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.scala",
              "match": "\\\\(u[0-9a-fA-F]{4}|[btnfr\"'\\\\])"
            }
          ]
        },
        {
          "name": "string.quoted.single.character.scala",
          "match": "'(\\\\(u[0-9a-fA-F]{4}|[btnfr\"'\\\\])|[^'\\\\])'"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "storage.type.annotation.scala",
          "match": "@[a-zA-Z_][a-zA-Z0-9_.]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.package.scala",
          "match": "\\b(package)\\b"
        },
        {
          "name": "keyword.other.import.scala",
          "match": "\\b(import)\\b"
        },
        {
          "name": "keyword.declaration.scala",
          "match": "\\b(class|trait|object|enum)\\b"
        },
        {
          "name": "keyword.declaration.stable.scala",
          "match": "\\b(val|var)\\b"
        },
        {
          "name": "keyword.declaration.scala",
          "match": "\\b(def|type)\\b"
        },
        {
          "name": "keyword.control.flow.scala",
          "match": "\\b(if|else|while|do|for|yield|return|throw|try|catch|finally)\\b"
        },
        {
          "name": "keyword.control.scala",
          "match": "\\b(abstract|sealed|final|lazy|implicit|override|private|protected|with|extends|new|match|case|super|this|forSome)\\b"
        },
        {
          "name": "storage.modifier.access.scala",
          "match": "\\b(private|protected|override)\\b"
        },
        {
          "name": "keyword.other.stable.scala",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "type-keywords": {
      "patterns": [
        {
          "name": "support.type.scala",
          "match": "\\b(Any|AnyRef|AnyVal|Nothing|Null|Unit|Boolean|Byte|Char|Short|Int|Long|Float|Double|String)\\b"
        },
        {
          "name": "support.type.collection.scala",
          "match": "\\b(Option|Some|None|List|Map|Set|Seq|Vector|Tuple|Array|Iterator|Iterable|Collection|MutableList|LinkedList|Queue|Stack|Buffer|ArrayBuffer|ArrayDeque|ListBuffer|StringBuilder)\\b"
        },
        {
          "name": "support.type.exception.scala",
          "match": "\\b(Exception|Throwable|RuntimeException|IllegalArgumentException|IllegalStateException|UnsupportedOperationException|NullPointerException|IndexOutOfBoundsException|ClassCastException|ArithmeticException|NumberFormatException|NoSuchElementException|Left|Right|Either)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.scala",
          "match": "(===|!==|==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.scala",
          "match": "(=>|<-|->|::|\\+\\+|\\+:=|:::)"
        },
        {
          "name": "keyword.operator.arithmetic.scala",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.logical.scala",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.other.scala",
          "match": "(#|\\?:|\\.\\.)"
        }
      ]
    },
    "symbols": {
      "patterns": [
        {
          "name": "constant.other.symbol.scala",
          "match": "'[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.scala",
          "match": "\\b0[xX][0-9a-fA-F_]+[lL]?\\b"
        },
        {
          "name": "constant.numeric.binary.scala",
          "match": "\\b0[bB][01_]+[lL]?\\b"
        },
        {
          "name": "constant.numeric.floating-point.scala",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)?[fFdD]?\\b"
        },
        {
          "name": "constant.numeric.floating-point.scala",
          "match": "\\b[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*[fFdD]?\\b"
        },
        {
          "name": "constant.numeric.integer.scala",
          "match": "\\b[0-9][0-9_]*[lL]?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.scala",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "type-declarations": {
      "patterns": [
        {
          "name": "entity.name.type.scala",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "method-declarations": {
      "patterns": [
        {
          "name": "entity.name.function.scala",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "packages": {
      "patterns": [
        {
          "name": "entity.name.namespace.scala",
          "match": "\\b[a-z][a-zA-Z0-9_]*(?=\\s*\\.)"
        }
      ]
    }
  }
}