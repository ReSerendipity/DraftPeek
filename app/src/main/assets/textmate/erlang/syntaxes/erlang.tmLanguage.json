{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Erlang",
  "scopeName": "source.erlang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#atoms_quoted" },
    { "include": "#macros" },
    { "include": "#records" },
    { "include": "#numbers" },
    { "include": "#module_attributes" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#variables" },
    { "include": "#atoms" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.percentage.erlang",
          "match": "%.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.erlang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.erlang",
              "match": "\\\\(b|d|e|f|n|r|s|t|v|\\\\|\\\"|\\'|\\^[A-Za-z]|[0-7]{1,3}|x[0-9A-Fa-f]{2}|x\\{[0-9A-Fa-f]+\\})"
            }
          ]
        }
      ]
    },
    "atoms_quoted": {
      "patterns": [
        {
          "name": "constant.other.symbol.quoted.erlang",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.erlang",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "atoms": {
      "patterns": [
        {
          "name": "constant.other.symbol.erlang",
          "match": "\\b[a-z][a-zA-Z0-9_@]*\\b"
        }
      ]
    },
    "macros": {
      "patterns": [
        {
          "name": "entity.name.function.macro.erlang",
          "match": "\\?[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "entity.name.function.macro.erlang",
          "match": "\\?\\?[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "records": {
      "patterns": [
        {
          "name": "entity.name.type.record.erlang",
          "match": "#[a-z][a-zA-Z0-9_]*"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.base.erlang",
          "match": "\\b[0-9]{1,2}#[0-9A-Za-z]+\\b"
        },
        {
          "name": "constant.numeric.float.erlang",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.erlang",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "constant.numeric.char.erlang",
          "match": "\\$\\\\?."
        }
      ]
    },
    "module_attributes": {
      "patterns": [
        {
          "name": "keyword.control.directive.erlang",
          "match": "^\\s*-\\s*(module|export|export_type|import|compile|define|undef|record|include|include_lib|behavior|behaviour|callback|spec|type|opaque|on_load|vsn|author)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.erlang",
          "match": "\\b(case|of|end|if|receive|after|when|try|catch|throw|begin|fun|let|query|cond)\\b"
        },
        {
          "name": "keyword.operator.logical.erlang",
          "match": "\\b(and|or|not|bnot|div|rem|band|bor|bxor|bsl|bsr|andalso|orelse|xor)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.erlang",
          "match": "(\\+\\+|--|\\+|-|\\*|/|==|/=|=:=|=/=|<|>|=<|>=|=|!|<-|\\||\\|\\||::)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.erlang",
          "match": "\\b[a-z][a-zA-Z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.erlang",
          "match": "(?<=^\\s*)[a-z][a-zA-Z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.erlang",
          "match": "\\b[A-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
