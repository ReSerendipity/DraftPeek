<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 禁止明文 HTTP 流量 -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- SECURITY VULN-017 FIXED: 证书锁定 api.github.com
         Pin 值来源：GitHub 公开证书的 SHA-256 公钥指纹（公开信息，非密钥）。
         主 pin：GitHub 当前 ECDSA 证书公钥指纹
         备份 pin：GitHub RSA 备用证书公钥指纹
         过期时间：2027-08-27（证书轮换时需更新） -->
    <domain-config>
        <domain includeSubdomains="false">api.github.com</domain>
        <pin-set expiration="2027-08-27">
            <pin digest="SHA-256">mQbXGHjmAKgSLEjPnLE8Z0oum2Nhb9Fh6BcOp3K9Q1M=</pin>
            <pin digest="SHA-256">6t4tKqmqJFWqHKaf7MrM1N5VxVCz0sXLYL1W0s3b6m0=</pin>
        </pin-set>
    </domain-config>

    <!-- Debug 模式下允许开发者工具使用明文流量（如调试 proxy） -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
