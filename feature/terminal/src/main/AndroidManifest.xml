<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for foreground service on Android 9+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required for foreground service type on Android 14+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- SECURITY: Signature-level permission to protect TerminalCommandReceiver.
         Only apps signed with the same key as DraftPeek can send broadcasts.
         VULN-001 fix: prevents arbitrary apps from executing terminal commands. -->
    <permission
        android:name="com.draftpeek.permission.TERMINAL_COMMAND"
        android:protectionLevel="signature"
        android:label="@string/permission_terminal_command_label"
        android:description="@string/permission_terminal_command_desc" />

    <!-- DraftPeek itself declares this permission so it can send broadcasts to its own receiver -->
    <uses-permission android:name="com.draftpeek.permission.TERMINAL_COMMAND" />

    <application>
        <service
            android:name=".service.TerminalService"
            android:foregroundServiceType="specialUse"
            android:exported="false"
            android:enabled="true">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="terminal_session" />
        </service>

        <!-- SECURITY VULN-001: Receiver now requires signature-level permission.
             External apps must be signed with the same key to send commands.
             The 'force' parameter has been removed entirely. -->
        <receiver
            android:name=".receiver.TerminalCommandReceiver"
            android:exported="true"
            android:permission="com.draftpeek.permission.TERMINAL_COMMAND"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.draftpeek.terminal.RUN_COMMAND" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
